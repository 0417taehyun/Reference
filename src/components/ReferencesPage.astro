---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Book from './Book.astro';
import site from '../content/site.json';
import { collectKeywords, excerptKeywords, keywordQuotes } from '../lib/keywords.mjs';
import { keywordLabel, interfaceText, type Language } from '../i18n/ui';

interface Props {
  language: Language;
}
const { language } = Astro.props;
const text = interfaceText[language];

const entries = (await getCollection('references', (entry) => entry.id.startsWith(`${language}/`))).sort(
  (first, second) => first.data.order - second.data.order,
);
const rendered = await Promise.all(
  entries.map(async (entry) => {
    const { Content, remarkPluginFrontmatter } = await render(entry);
    return { entry, Content, excerpts: remarkPluginFrontmatter.keywordExcerpts ?? [] };
  }),
);
// Keywords come from ==phrase=={keyword} tags; each tagged sentence becomes a quote.
const references = rendered.map(({ entry, excerpts }, index) => ({
  refId: entry.data.refId,
  number: String(index + 1).padStart(2, '0'),
  name: entry.data.name,
  title: entry.data.title,
  company: entry.data.company,
  photo: entry.data.photo,
  keywords: excerptKeywords(excerpts),
  excerpts,
}));
const keywords = collectKeywords(references).map((keyword) => ({
  ...keyword,
  label: keywordLabel(keyword.key, language),
  quotes: keywordQuotes(references, keyword.key),
}));

const name = site.name[language];
const title = `${name} · ${text.pageTitle}`;
---

<Base language={language} title={title} description={site.tagline[language]}>
  <Header language={language} />
  <Book language={language} rendered={rendered} keywords={keywords} />
</Base>
