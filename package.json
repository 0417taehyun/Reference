{
  "name": "reference",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:browser": "node scripts/check-book.mjs",
    "astro": "astro",
    "lint": "node scripts/check-code.mjs && npm run lint:references",
    "lint:references": "node scripts/references.mjs lint",
    "reference:translate": "node scripts/references.mjs translate",
    "reference:packet": "node scripts/references.mjs packet",
    "reference:apply": "node scripts/references.mjs apply",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --target es2022 --module esnext --moduleResolution bundler --allowJs src/scripts/book.ts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "markdownlint": "^0.42.0",
    "playwright-core": "^1.64.1",
    "pretendard": "^1.3.9",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "katex": "^0.18.2"
  }
}
